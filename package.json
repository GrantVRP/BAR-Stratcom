{
  "name": "bar-stratcom",
  "version": "3.0.0",
  "description": "BAR StratCom v3 — Live coaching desktop app for Beyond All Reason",
  "main": "out/main/index.js",
  "private": true,
  "license": "MIT",
  "author": "Grant",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:lua": "tsx tools/lint-lua.ts",
    "audit:fabrication": "tsx tools/audit-fabrication.ts",
    "perf:coach": "tsx src/main/perf/coach-bench.ts",
    "perf:app": "npm run build && tsx tools/perf/app-perf.ts",
    "package": "npm run build && electron-builder --win --x64",
    "smoke:package": "tsx tools/smoke-package.ts",
    "make:icon": "tsx tools/make-icon.ts",
    "validate:data": "tsx tools/validate-data.ts",
    "test": "vitest",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "show": "node tools/show-app.mjs",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,css,json}\" \"tools/**/*.{ts,js,mjs}\" \"tests/**/*.{ts,js}\" \"docs/**/*.json\" \"widget/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,css,json}\" \"tools/**/*.{ts,js,mjs}\" \"tests/**/*.{ts,js}\" \"docs/**/*.json\" \"widget/**/*.{ts,tsx,json}\"",
    "check:typography": "tsx tools/check-typography.ts",
    "check:links": "tsx tools/check-links.ts",
    "check:notices": "tsx tools/third-party-notices.ts --check",
    "notices": "tsx tools/third-party-notices.ts",
    "docs:screenshots": "npm run build && tsx tools/docs-screenshots.ts",
    "golden:update": "node -e \"console.log('No golden files to update.')\"",
    "verify": "npm run typecheck && npm run lint && npm run lint:lua && npm run audit:fabrication && npm run validate:data && npm run check:typography && npm run check:links && npm run check:notices && vitest run --coverage && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@google/genai": "2.27.0",
    "fflate": "^0.8.3",
    "openai": "7.28.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/luaparse": "^0.2.13",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.5",
    "luaparse": "^0.3.1",
    "lucide-react": "^1.49.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "wasmoon": "^1.16.0",
    "zustand": "^5.0.15"
  }
}
